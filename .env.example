# ─────────────────────────────────────────────────────────────────────────────
# Aruba Home Services — environment variables
#
# NOTHING here is required to preview the site. With no env vars the app runs
# in DEMO MODE: sample data from data/aruba-providers-seed.json, mock logins,
# everything clickable. Fill these in only when you're ready to go live.
# Copy this file to `.env.local` and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (database + real user accounts) ────────────────────────────────
# Create a free project at https://supabase.com → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" secret key — used by server actions and the seed import
# script. Keep it secret; never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email notifications (booking confirmations + invoices) ──────────────────
# Create a free API key at https://resend.com. Without a key, emails are
# logged to the server console instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="Aruba Home Services <invoices@yourdomain.aw>"

# ── Bank transfer details printed on every invoice ───────────────────────────
# Customers pay invoices by transferring to this Aruba Bank account.
INVOICE_BANK_NAME="Aruba Bank N.V."
INVOICE_BANK_ACCOUNT_NAME="Aruba Home Services VBA"
INVOICE_BANK_ACCOUNT_NUMBER="3200.4567.89"
INVOICE_BANK_IBAN="AW42 ARUB 3200 4567 89"
INVOICE_BANK_SWIFT="ARUBAWAX"

# ── Site URL (used in emails and OAuth redirects) ────────────────────────────
# Local preview: http://localhost:3000 — Production: your Vercel domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
